  "unavailable": [
    {
      "dimension": "multi-line edit diff context",
      "reason": "The reference computes occurrence diffs with difflib and keeps two context lines; the port renders the replaced and replacing lines, which coincide whenever an occurrence shares no line with its replacement."
    },
    {
      "dimension": "syntax highlighting inside file and command output",
      "reason": "The reference wraps read, write, and shell output in a Markdown code fence whose highlighting is produced by Rich at paint time; the oracle can pin the fenced content but not the per-token colours."
    },
    {
      "dimension": "tool result expansion by mouse click",
      "reason": "The reference expands a collapsible result through a Textual click handler on a mounted section; the terminal port exposes the same content through its keyboard collapse toggle instead."
    },
    {
      "dimension": "tool stream delta",
      "reason": "The reference streams the JSON-patch delta appended to `state.outputText`; the port has no patch channel and shows the newest output line instead, so the two cannot be compared token for token."
    }
  ]
